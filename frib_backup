#!/bin/dash

###
#
#
#
###

USAGE="Usage: $0 [OPTIONS] [DESTINATION]
Create disk snapshot.

Create a backup of the partition table, then zstd compress each partition.
The backup is created in DESTINATION. If --ssh is specified, a sshfs
mount in /tmp is used and the DESTINATION may be omitted.

Options:
  --ssh user@server:base_dir  Use sshfs to store files on server
  --ptable                    Backup partitions to ptable.zip
  --pprofile PROFILE          Specify profile for partition backup
  --parts PART1,[PART2 ...]   Only backup listed partitions
  --gui                       Show a Dialog-based UI
"

FRIB_PARTITION=$( cd -P -- "$(dirname -- "$(command -v -- "$0")")" && pwd -P )/frib_partition

cleanup(){
    if [ ! -z "${SSH_MOUNT}" ]
    then
        # echo "unmount ${SSH_MOUNT}"
        fusermount -u "${SSH_MOUNT}"
    fi
    # echo "remove ${SSH_DIR}"
    if [ ! -z "${SSH_DIR}" ]
    then
        rmdir "${SSH_DIR}"
    fi
}

trap cleanup EXIT

connect_ssh(){
    if [ -z "${SSH_DIR}" ]
    then
        SSH_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t 'fribackup')
    else
        if [ ! -z "${SSH_MOUNT}" ]
        then
            fusermount -u "${SSH_MOUNT}"
        fi
    fi
    # echo "sshfs ${SSH_DEST} ${SSH_DIR}";
    if sshfs "${SSH_DEST}" "${SSH_DIR}";
    then
        SSH_MOUNT="${SSH_DIR}"
        DEST="${SSH_MOUNT}"
        ls "${SSH_DIR}" > /dev/null
    else
        DEST=""
        SSH_DIR=""
    fi
}

gui_dest(){
    ret=$(dialog --menu "Pick destination" 20 80 10 "SSH" "Connect over SSH" "Dir" "Pick directory" 3>&1 1>&2 2>&3)
    case "${ret}" in
 SSH)
            ret=$(dialog --inputbox "Enter user@server:base_dir" 20 80 "${SSH_DEST}" 3>&1 1>&2 2>&3)
            if [ ! -z "${ret}" ]
            then
                SSH_DEST="${ret}"
                connect_ssh "${SSH_DEST}"
            fi
        ;;
        Dir)
            ret=$(dialog --dselect "${DEST}" 20 80 3>&1 1>&2 2>&3)
            if [ ! -z "${ret}" ]
            then
                DEST="${ret}"
            fi
        ;;
    esac
}

gui_ptable(){
    if [ -z "${DEST}" ]
    then
        ret=$(dialog --msgbox "Select destination first! ${DEST}" 20 80 3>&1 1>&2 2>&3)
    else
        if [ ! -z "${ret}" ]
        then
            PARTBACKUP_FILE="ptable.zip"
            if [ -f "${DEST}/${PARTBACKUP_FILE}" ]
            then
                existing_profiles=$($FRIB_PARTITION list "${DEST}/${PARTBACKUP_FILE}")
                if [ -z "${PARTBACKUP_PROFILE}" ]
                then
                    default_profile=$($FRIB_PARTITION match "${DEST}/${PARTBACKUP_FILE}")
                else
                    default_profile="${PARTBACKUP_PROFILE}"
                fi
            else
                existing_profiles=""
                default_profile="default"
            fi
            ret=$(dialog --inputbox "Profile (currently avaliable)\n${existing_profiles}" 20 80 "${default_profile}" 3>&1 1>&2 2>&3)
            if [ ! -z "${ret}" ]
            then
                PARTBACKUP_PROFILE="${ret}"
                partresult=$( $FRIB_PARTITION backup "${DEST}/${PARTBACKUP_FILE}" "${PARTBACKUP_PROFILE}" )
                ret=$(dialog --msgbox "${partresult}" 20 80 3>&1 1>&2 2>&3)
            fi
        fi
    fi
}

gui_select(){
    TAG_ITEM_STATE=""
    for DEVFILE in /dev/disk/by-partuuid/*
    do
        if [ -b "${DEVFILE}" ]
        then
            PART=$( basename $(readlink "${DEVFILE}" ) )
            TAG_ITEM_STATE="${DEVFILE} ${PART} on ${TAG_ITEM_STATE}"
        fi
    done
    NEW_PARTS=$(dialog --checklist "Select partition UUIDs"\
                25 80 10\
                ${TAG_ITEM_STATE}\
                3>&1 1>&2 2>&3);
    if [ $? = 0 ]
    then
        PARTS=$(echo $NEW_PARTS | tr ' ' ',')
    fi
}

gui_backup(){
    if [ -z "${DEST}" ]
    then
        ret=$(dialog --msgbox "Select destination first! ${DEST}" 20 80 3>&1 1>&2 2>&3)
    else
        ret=$(dialog --msgbox "${PARTS}" 20 80 3>&1 1>&2 2>&3)
        IFS=","
        for PART in $PARTS
        do
            UUID=$(lsblk "${PART}" -d -n -o PARTUUID)
            if [ ! -z "${UUID}" ]
            then
                zstd -z --force --progress "${PART}" -o "${DEST}/${UUID}.zstd" 2>&1 | stdbuf -o0 tr '\r' '\n' | sed -u -e '/^ *$/d' -e 's/.*==> //' -e 's/% *$//' | dialog --gauge "Backing up ${PART} to ${DEST}/${UUID}.zstd" 20 80
            else
                ret=$(dialog --infobox "NOT backing up ${PART}" 20 80 3>&1 1>&2 2>&3)
                sleep 5
            fi
        done
    fi
}

backup(){
    if [ -z "${DEST}" ]
    then
        echo "Destination not specified" >&2
    else
        IFS=","
        for PART in $PARTS
        do
            UUID=$(lsblk "${PART}" -d -n -o PARTUUID)
            echo "Try backing up ${PART} to ${DEST}/${UUID}.zstd" >&2
            if [ ! -z "${UUID}" ]
            then
                zstd -z --force --progress "${PART}" -o "${DEST}/${UUID}.zstd"
            else
                echo "NOT backing up ${PART}" >&2
            fi
        done
    fi
}

gui(){
    # bla=$(dialog --checklist "particije" 300 200 10 tag item on tag2 item2 off tag3 item3 on tag4 item4 on tag5 item5 on tag6 item6 truetag7 item7 1 3>&1 1>&2 2>&3); reset; echo $bla
    # dialog ""
    while true
    do
        ret=$(dialog --nook --menu "FRI Backup Create (${SSH_DEST} ${DEST}: ${PARTS})" 20 80 10 "Dest" "Select destination" "Parttable" "Backup partition table" "Select" "Select partitions to backup" "Backup" "Backup selected partitions" "Quit" "Exit program" 3>&1 1>&2 2>&3)
        case "${ret}" in
            Dest)
                gui_dest
            ;;
            Parttable)
                gui_ptable
            ;;
            Select)
                gui_select
            ;;
            Backup)
                gui_backup
            ;;
            *)
                break
            ;;
        esac
    done
}


UUIDS=""
DEST=""
PARTBACKUP_FILE=""
PARTBACKUP_PROFILE=""

if [ "$#" -eq 0 ]
then
    echo "${USAGE}"
    exit 1
else
    while [ "$#" -gt 0 ]
    do
        case "$1" in
            --ssh)
                SSH_DEST="$2"
                shift 2
            ;;
            --ptable)
                PARTBACKUP_FILE="ptable.zip"
                shift 1
            ;;
            --pprofile)
                PARTBACKUP_PROFILE="$2"
                shift 2
            ;;
            --parts)
                PARTS="$2"
                shift 2
            ;;
            --gui)
                shift 1
                SHOW_GUI="tui"
            ;;
            --help)
                echo "${USAGE}"
                exit 1
            ;;
            *)
                DEST="$1"
                shift 1
            ;;
        esac
    done
fi

# SSHOT_DIR=$1

if [ -z "${PARTS}" ]
then
    PARTS=""
    for DEVFILE in /dev/disk/by-partuuid/*
    do
        if [ -z "${PARTS}" ]
        then
            PARTS="${DEVFILE}"
        else
            PARTS="${PARTS},${DEVFILE}"
        fi
    done
fi


if [ ! -z "${SSH_DEST}" ]
then
    connect_ssh
fi

if [ "${SHOW_GUI}" = "tui" ]
then
    gui
    exit 0
else
    if [ ! -z "${PARTBACKUP_FILE}" ] 
    then
        if [ -f "${DEST}/${PARTBACKUP_FILE}" ]
        then
            if [ -z "${PARTBACKUP_PROFILE}" ]
            then
                PARTBACKUP_PROFILE=$($FRIB_PARTITION match "${DEST}/${PARTBACKUP_FILE}")
            fi
        fi
        if [ -z "${PARTBACKUP_PROFILE}" ]
        then
            PARTBACKUP_PROFILE=default
        fi
        $FRIB_PARTITION backup "${DEST}/${PARTBACKUP_FILE}" "${PARTBACKUP_PROFILE}"
    fi
    backup
fi
